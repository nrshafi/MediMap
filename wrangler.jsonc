{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medimap",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    // OAuth callback codes and location coordinates use query strings.
    // Configure verified URL redaction before collecting automatic traces.
    "traces": { "enabled": true, "head_sampling_rate": 0 },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medimap-catalog-local",
      // Local placeholder. Remote provisioning needs separate authorization.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  // Demo deployment. Build with CLOUDFLARE_ENV=production.
  // GOOGLE_MAPS_BROWSER_KEY and GOOGLE_MAPS_SERVER_KEY are Worker secrets.
  "env": {
    "production": {
      "name": "medimap",
      "account_id": "004edbba5c2bcea9f103ae2111889af7",
      "vars": { "AUTH_ORIGIN": "https://medimap.nrshafi.workers.dev" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "medimap-catalog",
          "database_id": "ffa4f88a-399c-4ef3-9716-3eae38c819f0",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
