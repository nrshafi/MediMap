{
  "name": "medimap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "typecheck": "bun check --no-script",
    "format": "bun fmt src tests *.ts *.json bunfig.toml .oxlintrc.json README.md",
    "format:check": "bun fmt --check src tests *.ts *.json bunfig.toml .oxlintrc.json README.md",
    "test:coverage": "bun test --coverage --coverage-reporter=text",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.bun-cache/playwright playwright test",
    "test:browser:install": "PLAYWRIGHT_BROWSERS_PATH=.bun-cache/playwright playwright install chromium --only-shell",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.1",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  }
}
