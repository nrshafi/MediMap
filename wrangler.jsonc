{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medimap",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    // OAuth callback codes and location coordinates use query strings.
    // Configure verified URL redaction before collecting automatic traces.
    "traces": { "enabled": true, "head_sampling_rate": 0 },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medimap-catalog-local",
      // Local placeholder. Remote provisioning needs separate authorization.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
}
